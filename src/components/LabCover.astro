---
// The "hero image" for a lab, drawn in CSS so every lab gets the same cover
// from its frontmatter alone: a terminal window with the topic typed at the prompt.
import { getCollection } from 'astro:content';

interface Props {
	topic: string;
	level: string;
	duration: number;
	/** `card` is a 16:9 tile for listings; `banner` is the full-width band on a lab page. */
	variant?: 'card' | 'banner';
}

const { topic, level, duration, variant = 'card' } = Astro.props;
// Monospace, so the longest topic decides how large every topic can be and still fit
// on one line. All covers share that size, so a short topic is not shouted.
const labs = await getCollection('labs');
const chars = Math.max(topic.length, ...labs.map((lab) => lab.data.topic.length), 6);
---

<div class:list={['lab-cover', `lab-cover-${variant}`]}>
	<div class="term" style={`--chars: ${chars}`}>
		<div class="term-bar" aria-hidden="true">
			<span class="term-dots"><i></i><i></i><i></i></span>
			<span class="term-title">lab — zsh</span>
		</div>
		<div class="term-body">
			<span class="term-prompt" aria-hidden="true"><span class="term-path">~/labs</span> <span class="term-caret">❯</span> start</span>
			<span class="term-topic">{topic}<span class="term-cursor" aria-hidden="true"></span></span>
		</div>
		<div class="term-status">
			<span class="term-tag">lab</span>
			<span>{level.toLowerCase()}</span>
			<span class="term-duration">{duration} min</span>
		</div>
	</div>
</div>

<style>
	/* A terminal is dark whatever the page theme, so these colors are fixed
	   rather than following the light/dark tokens; only the accent is shared. */
	.lab-cover {
		--term-bg: #1d1814;
		--term-bar: #2a231d;
		--term-text: #e8e0d8;
		--term-dim: #8f8074;
		--term-line: rgba(232, 224, 216, 0.08);
		display: block;
	}
	.term {
		container-type: inline-size;
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border-radius: 10px;
		border: 1px solid var(--term-line);
		background:
			repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0, 0, 0, 0.12) 2px 3px),
			var(--term-bg);
		color: var(--term-text);
		font-family: ui-monospace, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
	}

	.term-bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.55rem 0.8rem;
		background: var(--term-bar);
		border-bottom: 1px solid var(--term-line);
		font-size: 0.72rem;
		line-height: 1;
		color: var(--term-dim);
	}
	.term-dots {
		display: flex;
		gap: 0.35rem;
	}
	.term-dots i {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--term-dim);
		opacity: 0.45;
	}
	.term-dots i:first-child {
		background: var(--accent);
		opacity: 1;
	}
	.term-title {
		flex: 1;
		text-align: center;
		/* balance the dots so the title sits in the true centre */
		margin-right: 2.35rem;
	}

	.term-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.6rem;
		padding: 1rem 1.25rem;
	}
	.term-prompt {
		font-size: 0.85rem;
		line-height: 1;
		color: var(--term-text);
	}
	.term-path {
		color: var(--term-dim);
	}
	.term-caret {
		color: var(--accent);
	}
	.term-topic {
		/* ~0.6em per monospace character, plus room for the cursor */
		font-size: min(calc(82cqw / (var(--chars) * 0.6 + 1)), 4.5rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.05;
		white-space: nowrap;
		color: var(--term-text);
		text-shadow: 0 0 0.35em rgba(var(--accent-rgb), 0.25);
	}
	.term-cursor {
		display: inline-block;
		width: 0.08em;
		height: 1em;
		margin-left: 0.06em;
		vertical-align: -0.14em;
		background: var(--accent);
	}

	.term-status {
		display: flex;
		align-items: stretch;
		gap: 0.75rem;
		background: var(--term-bar);
		border-top: 1px solid var(--term-line);
		font-size: 0.72rem;
		line-height: 1;
		color: var(--term-dim);
	}
	.term-status > span {
		padding: 0.45rem 0;
	}
	.term-tag {
		padding-inline: 0.7rem !important;
		background: var(--accent);
		color: var(--term-bg);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}
	.term-duration {
		margin-left: auto;
		padding-right: 0.8rem !important;
	}

	@keyframes term-blink {
		50% { opacity: 0; }
	}

	/* Card: a 16:9 window; the cursor blinks only while hovered */
	.lab-cover-card {
		aspect-ratio: 16 / 9;
	}
	:global(a:hover) .lab-cover-card .term-cursor,
	:global(a:focus-visible) .lab-cover-card .term-cursor {
		animation: term-blink 1.1s steps(1) infinite;
	}

	/* Banner: a band in the page surface with the window on the article column */
	.lab-cover-banner {
		padding: 2.5rem 1rem;
		background: var(--surface);
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.lab-cover-banner .term {
		width: 720px;
		max-width: 100%;
		min-height: 280px;
		margin: 0 auto;
		box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.45);
	}
	.lab-cover-banner .term-body {
		padding: 1.75rem 2rem;
		gap: 0.9rem;
	}
	.lab-cover-banner .term-prompt {
		font-size: 1rem;
	}
	.lab-cover-banner .term-cursor {
		animation: term-blink 1.1s steps(1) infinite;
	}
	@media (max-width: 720px) {
		.lab-cover-banner { padding: 1.5rem 1rem; }
		.lab-cover-banner .term { min-height: 200px; }
		.lab-cover-banner .term-body { padding: 1.25rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.term-cursor { animation: none !important; }
	}
</style>
