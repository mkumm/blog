---
import { Image } from 'astro:assets';

interface Props {
  img_src: ImageMetadata;
  name: string;
  link: string;
}

const { img_src, name, link } = Astro.props;
---


   <a href={link}>{name}</a>&nbsp;
  <a href={link}>
    <Image src={img_src} width={36} densities={[1, 2]} class="inline-img w-6 h-6 rounded-full inline hover:scale-150 transition" alt={"profile " + name + " "} /></a>


<style>
  .inline-img {
    display: inline !important;
    width: 1.5rem !important;
    height: 1.5rem !important;
    margin: 0 !important;
    max-width: 1.5rem !important;
  }
</style>
