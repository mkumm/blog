---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectSpotlight from '../../components/ProjectSpotlight.astro';
import { SITE_TITLE } from '../../consts';
import ProjectsHeroImage from '../../assets/pages/hero-projects.png';
import { Image } from 'astro:assets';

const projects = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Projects — ${SITE_TITLE}`}
			description="Side projects I've built and shipped — apps, games, and tools."
		/>
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "ItemList",
			"name": "Projects — Michael Kumm",
			"url": "https://mkumm.com/projects/",
			"itemListElement": projects.map((project, i) => ({
				"@type": "ListItem",
				"position": i + 1,
				"url": `https://mkumm.com/projects/${project.id}/`,
				"name": project.data.title,
			}))
		})}></script>
		<style>
			.hero-image img {
				display: block;
				width: 100%;
				max-height: 440px;
				object-fit: cover;
				border-radius: 0;
			}
			@media (max-width: 720px) {
				.hero-image img { max-height: 220px; }
			}
			main {
				width: 760px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5rem 0;
			}
			.page-header {
				margin-bottom: 2.5rem;
				padding-bottom: 1.25rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.page-header h1 {
				margin: 0 0 0.25rem 0;
				font-size: 2rem;
			}
			.page-header p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.spotlight-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				column-gap: 2.5rem;
				row-gap: 3.5rem;
			}
			@media (max-width: 720px) {
				.spotlight-grid { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="hero-image">
			<Image src={ProjectsHeroImage} alt="Projects page hero" loading="eager" />
		</div>
		<main>
			<div class="page-header">
				<h1>Projects</h1>
				<p>Side projects I've built and shipped — apps, games, and tools.</p>
			</div>
			<div class="spotlight-grid">
				{projects.map((project) => (
					<ProjectSpotlight slug={project.id} showTagline showStatus />
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>
