---
import NowHeroImage from "../assets/pages/hero-now.png";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { SITE_TITLE } from "../consts";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import PersonLink from "../components/PersonLink.astro";
import { books, albums } from "../data/now";

const recentShorts = (await getCollection('shorts'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const readingBooks = books.filter(b => b.status === 'reading');
const finishedBooks = books.filter(b => b.status === 'finished');

function progressBar(pct: number): { filled: string; empty: string } {
	const total = 20;
	const n = Math.round(pct * total / 100);
	return { filled: '█'.repeat(n), empty: '░'.repeat(total - n) };
}

function starSegments(rating: number): Array<'full' | 'half' | 'empty'> {
	return Array.from({ length: 5 }, (_, i) => {
		const pos = i + 1;
		if (rating >= pos) return 'full';
		if (rating >= pos - 0.5) return 'half';
		return 'empty';
	});
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Now — ${SITE_TITLE}`}
			description="What I'm focused on right now — inspired by Derek Sivers' now page movement."
		/>
		<style>
			.hero-image img {
				display: block;
				width: 100%;
				max-height: 440px;
				object-fit: cover;
				border-radius: 0;
			}
			@media (max-width: 720px) {
				.hero-image img { max-height: 220px; }
			}
			main {
				width: 760px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5rem 1.5rem;
			}
			.page-header {
				margin-bottom: 2.5rem;
				padding-bottom: 1.25rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.page-header h1 {
				margin: 0 0 0.25rem 0;
				font-size: 2rem;
			}
			.page-header p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			@media (max-width: 720px) {
				main { width: 100%; max-width: 100%; padding: 1.5rem 1rem; }
			}
			.shorts-list {
				list-style: none;
				padding: 0;
				margin: 0 0 1rem 0;
			}
			.shorts-list li {
				padding: 0.75rem 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.shorts-list li:first-child {
				border-top: 1px solid rgb(var(--gray-light));
			}
			.shorts-list a {
				display: flex;
				gap: 1rem;
				align-items: baseline;
				text-decoration: none;
				color: inherit;
			}
			.shorts-list a:hover .short-title {
				color: var(--accent);
			}
			.short-date {
				font-size: 0.78rem;
				text-transform: uppercase;
				letter-spacing: 0.07em;
				font-weight: 500;
				color: rgb(var(--gray));
				white-space: nowrap;
				flex-shrink: 0;
			}
			.short-title {
				font-family: 'Lora', Georgia, serif;
				font-weight: 600;
				color: rgb(var(--black));
				transition: color 0.15s ease;
			}
			.short-description {
				font-size: 0.9rem;
				color: rgb(var(--gray));
				margin: 0.2rem 0 0 0;
			}
.see-all {
				font-size: 0.95rem;
				font-weight: 500;
			}
			.item-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.item-list li {
				padding: 0.85rem 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.item-list li:first-child {
				border-top: 1px solid rgb(var(--gray-light));
			}
			.item-row {
				display: flex;
				gap: 0.85rem;
				align-items: flex-start;
			}
			.item-thumb {
				width: 72px;
				flex-shrink: 0;
				border-radius: 3px;
				object-fit: cover;
				display: block;
			}
			.item-thumb.book {
				height: 100px;
			}
			.item-thumb.music {
				height: 72px;
			}
			.item-content {
				flex: 1;
				min-width: 0;
			}
			.item-header {
				display: flex;
				align-items: center;
				gap: 0.65rem;
				margin-bottom: 0.3rem;
			}
			.item-title {
				font-family: 'Lora', Georgia, serif;
				font-weight: 600;
				color: rgb(var(--black));
				text-decoration: none;
			}
			.item-title:hover {
				color: var(--accent);
			}
			.progress-bar {
				display: flex;
				align-items: center;
				gap: 0.35rem;
				margin-top: 0.35rem;
				font-family: 'Courier New', Courier, monospace;
				font-size: 0.78rem;
				line-height: 1;
			}
			.progress-filled {
				color: var(--accent);
			}
			.progress-empty {
				color: rgb(var(--gray-light));
			}
			.progress-pct {
				color: rgb(var(--gray));
				font-size: 0.72rem;
			}
			.star-display {
				display: inline-flex;
				gap: 0.05rem;
				margin-top: 0.35rem;
				font-size: 1rem;
				line-height: 1;
			}
			.star {
				position: relative;
				display: inline-block;
				color: rgb(var(--gray-light));
			}
			.star.full {
				color: var(--accent);
			}
			.star.half::after {
				content: '★';
				position: absolute;
				left: 0;
				top: 0;
				clip-path: inset(0 50% 0 0);
				color: var(--accent);
			}
			.item-note {
				font-size: 0.9rem;
				color: rgb(var(--gray));
				margin: 0;
			}
			@media (max-width: 720px) {
				.item-thumb {
					width: 56px;
					max-width: 56px;
					margin-left: 0;
					margin-right: 0;
					border-radius: 3px;
				}
				.item-thumb.book {
					height: 78px;
				}
				.item-thumb.music {
					height: 56px;
				}
				.item-row {
					gap: 0.65rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="hero-image">
			<Image src={NowHeroImage} alt="Now page hero" loading="eager" />
		</div>
		<main>
			<div class="page-header">
				<h1>Now Page</h1>
				<p>A quick intro and what's going on "now" — last updated August 27, 2026.</p>
			</div>

			<p>
				This is a <a href="https://nownownow.com/about">now page</a>.
				<PersonLink
					img_src="/profiles/sivers.png"
					name="Derek Sivers"
					link="https://sive.rs/"
				/> has inspired
				<a href="https://nownownow.com/">a growing number of "nowers"</a>
				to create these. If you have your own site, you should consider adding a
				<b>Now page</b> too.
			</p>

			<h2>🛫 Detroit ⇄ Krakow 🛬</h2>
			<p>
				I am an American traveling back and forth from Detroit to Krakow, Poland (yes, legally — I have my Polish Karta).
			</p>
			<p>
				Poland is more beautiful and more relaxed than any imagination I had when I was young. Living in Krakow gives me the luxury of walking to the cafe, riding my bike through any number of parks, maybe taking the tram into the square for a nice meal, then capping it off with a drink at our local beer garden — with live music on the weekends. The people are wonderful, laid back, and there is just a lack of manufactured stress for most people. I highly recommend a visit.
			</p>

			<h2>🎰 Working at DraftKings 👑</h2>
			<p>
				Claude and I write a lot of Elixir code these days at <a href="https://www.draftkings.com/">DraftKings</a>. Although I have the same job I had last year, I would not recognize my day to day work from a year ago. AI is here, like it or not — I choose to like it, and I am having more fun!
			</p>

			<h2>👨‍💻 Solo Projects 🖥️</h2>
			<dl>
				<dt>🏈 Sprytna League</dt>
				<dd>
					I am so excited for the start of the football season. Especially because of <a href="https://sprytnaleague.com">sprytnaleague.com</a>, a "price is right" style of weekly football fun. A friend and I prototyped it last year, and now we've automated the process and let others join.</dd>

				<dt>📈 Sprytna OKRs</dt>
				<dd>
					I built my own OKR application. It does everything I want and nothing I don't, tailored to a minimalist take on OKRs (I have strong opinions on this): <a href="https://sprytnaokrs.com">sprytnaokrs.com</a>. If you use OKRs personally or with a small group, feel free to request an invite.</dd>

				<dt>🎲 Any One Will Do</dt>
				<dd>A randomizer built with the features I actually wanted: no ads, random group formation,
				and a cleaner experience. I am seeing some really nice traction on repeat usage, half the visitors coming from direct links. If you are tired of "wheel of names" (a very good randomizer, but with ads) give <a href="https://anyonewilldo.com">anyonewilldo.com</a> a try.</dd>

				<dt>📇 Sprytna Cards</dt>
				<dd>I loved this little project — private-first NFC business cards. It helped me learn a lot about what to do and what not to do when launching a technical product. I still have active users, but the project is in maintenance mode: <a href="https://sprytna.cards/">sprytna.cards</a></dd>

				<dt>📍 Sprytna Maps</dt>
				<dd>A way to share your city with people who matter — build a personal map of your
				favorite spots and send it to friends visiting your town.
				<a href="https://sprytnamaps.com">sprytnamaps.com</a></dd>

				<dt>🧘‍♂️ Sprytna Meditation</dt>
				<dd>My personal online (PWA) meditation timer. Minimalist design, no ads and all data is private and local. I use it every day. Help yourself.
				<a href="https://sprytnameditation.com">sprytnameditation.com</a></dd>

				<dt>✅ 99 Days Of</dt>
				<dd>My personal online (PWA) habit tracker. Built on my belief that habits can form in around 30 days, but they become fully integrated in 100 days. Minimalist design, no ads and all data is private and local. I use it every day. Help yourself.
				<a href="https://99daysof.com">99daysof.com</a></dd>
			</dl>

			<h2>Personal Writing</h2>
			<p>
				My <a href="/shorts/">Shorts</a> are the more personal corner of this site — quick notes,
				observations, and things from daily life in Krakow, side projects, and whatever catches
				my attention. Think of it as a personal blog in compact form.
			</p>
			<ul class="shorts-list">
				{recentShorts.map((post) => (
					<li>
						<a href={`/shorts/${post.id}/`}>
							<span class="short-date"><FormattedDate date={post.data.pubDate} /></span>
							<span class="short-title">{post.data.title}</span>
						</a>
						{post.data.description && <p class="short-description">{post.data.description}</p>}
					</li>
				))}
			</ul>
			<a href="/shorts/" class="see-all">See all shorts →</a>



			<h2>📖 Currently Reading</h2>
			<ul class="item-list">
				{readingBooks.map(book => (
					<li>
						<div class="item-row">
							<img src={book.image} class="item-thumb book" alt={`${book.title} cover`} />
							<div class="item-content">
								<div class="item-header">
									<a href={book.url} class="item-title">{book.title}</a>
								</div>
								{book.note && <p class="item-note">{book.note}</p>}
								<div class="progress-bar">
									<span class="progress-filled">{progressBar(book.progress!).filled}</span><span class="progress-empty">{progressBar(book.progress!).empty}</span>
									<span class="progress-pct">{book.progress}%</span>
								</div>
							</div>
						</div>
					</li>
				))}
			</ul>

			<h2>📚 Just Finished</h2>
			<ul class="item-list">
				{finishedBooks.map(book => (
					<li>
						<div class="item-row">
							<img src={book.image} class="item-thumb book" alt={`${book.title} cover`} />
							<div class="item-content">
								<div class="item-header">
									<a href={book.url} class="item-title">{book.title}</a>
								</div>
								<div class="star-display">
									{starSegments(book.rating!).map(s => (
										<span class={`star ${s}`}>{s === 'full' ? '★' : '☆'}</span>
									))}
								</div>
								{book.note && <p class="item-note">{book.note}</p>}
							</div>
						</div>
					</li>
				))}
			</ul>

			<h2>🎶 Heavy Rotation</h2>
			<ul class="item-list">
				{albums.map(album => (
					<li>
						<div class="item-row">
							<img src={album.image} class="item-thumb music" alt={`${album.title} album art`} />
							<div class="item-content">
								<div class="item-header">
									<a href={album.url} class="item-title">{album.title}</a>
								</div>
								<p class="item-note">{album.artist}</p>
							</div>
						</div>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
