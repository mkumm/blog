---
import NowHeroImage from "../assets/pages/hero-now.png";
import ParkImage from "../assets/now/park-1.png";
import { Image } from "astro:assets";
import { SITE_TITLE } from "../consts";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PersonLink from "../components/PersonLink.astro";
import LocationWidget from "../components/LocationWidget.astro";
import ProjectSpotlight from "../components/ProjectSpotlight.astro";
import { books, albums } from "../data/now";

const readingBooks = books.filter(b => b.status === 'reading');
const finishedBooks = books.filter(b => b.status === 'finished');

function progressBar(pct: number): { filled: string; empty: string } {
	const total = 20;
	const n = Math.round(pct * total / 100);
	return { filled: '█'.repeat(n), empty: '░'.repeat(total - n) };
}

function starSegments(rating: number): Array<'full' | 'half' | 'empty'> {
	return Array.from({ length: 5 }, (_, i) => {
		const pos = i + 1;
		if (rating >= pos) return 'full';
		if (rating >= pos - 0.5) return 'half';
		return 'empty';
	});
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Now — ${SITE_TITLE}`}
			description="What I'm focused on right now — inspired by Derek Sivers' now page movement."
		/>
		<style>
			.hero-image img {
				display: block;
				width: 100%;
				max-height: 440px;
				object-fit: cover;
				border-radius: 0;
			}
			@media (max-width: 720px) {
				.hero-image img { max-height: 220px; }
			}
			main {
				width: 760px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5rem 1.5rem;
			}
			.page-header {
				margin-bottom: 2.5rem;
				padding-bottom: 1.25rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.page-header h1 {
				margin: 0 0 0.25rem 0;
				font-size: 2rem;
			}
			.page-header p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			@media (max-width: 720px) {
				main { width: 100%; max-width: 100%; padding: 1.5rem 1rem; }
			}
			.item-list {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				column-gap: 1.75rem;
				list-style: none;
				padding: 0;
				margin: 0;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.item-list li {
				padding: 0.85rem 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			@media (max-width: 560px) {
				.item-list {
					grid-template-columns: 1fr;
				}
			}
			.item-row {
				display: flex;
				gap: 0.85rem;
				align-items: flex-start;
			}
			.item-thumb {
				width: 72px;
				flex-shrink: 0;
				border-radius: 3px;
				object-fit: cover;
				display: block;
			}
			.item-thumb.book {
				height: 100px;
			}
			.item-thumb.music {
				height: 72px;
			}
			.item-content {
				flex: 1;
				min-width: 0;
			}
			.item-header {
				display: flex;
				align-items: center;
				gap: 0.65rem;
				margin-bottom: 0.3rem;
			}
			.item-title {
				font-family: 'Lora', Georgia, serif;
				font-weight: 600;
				color: rgb(var(--black));
				text-decoration: none;
			}
			.item-title:hover {
				color: var(--accent);
			}
			.progress-bar {
				display: flex;
				align-items: center;
				gap: 0.35rem;
				margin: 0.35rem 0;
				font-family: 'Courier New', Courier, monospace;
				font-size: 0.78rem;
				line-height: 1;
			}
			.progress-filled {
				color: var(--accent);
			}
			.progress-empty {
				color: rgb(var(--gray-light));
			}
			.progress-pct {
				color: rgb(var(--gray));
				font-size: 0.72rem;
			}
			.star-display {
				display: inline-flex;
				gap: 0.05rem;
				margin-top: 0.35rem;
				font-size: 1rem;
				line-height: 1;
			}
			.star {
				position: relative;
				display: inline-block;
				color: rgb(var(--gray-light));
			}
			.star.full {
				color: var(--accent);
			}
			.star.half::after {
				content: '★';
				position: absolute;
				left: 0;
				top: 0;
				clip-path: inset(0 50% 0 0);
				color: var(--accent);
			}
			.item-note {
				font-size: 0.9rem;
				color: rgb(var(--gray));
				margin: 0;
			}
			@media (max-width: 720px) {
				.item-thumb {
					width: 56px;
					max-width: 56px;
					margin-left: 0;
					margin-right: 0;
					border-radius: 3px;
				}
				.item-thumb.book {
					height: 78px;
				}
				.item-thumb.music {
					height: 56px;
				}
				.item-row {
					gap: 0.65rem;
				}
			}
			.captioned-image {
				margin: 1.75rem 0;
			}
			.captioned-image img {
				margin: 0;
			}
			.captioned-image figcaption {
				margin-top: 0.6rem;
				font-family: 'Lora', Georgia, serif;
				font-style: italic;
				font-size: 0.88rem;
				color: rgb(var(--gray));
				text-align: center;
			}
			.spotlight-row {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.75rem;
				margin: 1.5rem 0;
			}
			@media (max-width: 600px) {
				.spotlight-row {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="hero-image">
			<Image src={NowHeroImage} alt="Now page hero" loading="eager" />
		</div>
		<main>
			<div class="page-header">
				<h1>Now Page</h1>
				<p>A quick intro and what's going on "now" — last updated August 27, 2026.</p>
			</div>

			<div class="">
			<p>
				This is a <a href="https://nownownow.com/about">now page</a>. <PersonLink
					img_src="/profiles/sivers.png"
					name="Derek Sivers"
					link="https://sive.rs/"
				/> has inspired <a href="https://nownownow.com/">a growing number of "nowers"</a> to create these. If you have your own site, you should consider adding a <b>Now page</b> too.
			</p>

			<h2>🎰 Working at DraftKings</h2>
			<p>
				Claude and I write a lot of Elixir code these days at <a href="https://www.draftkings.com/">DraftKings</a>. Although I have the same job I had last year, I would not recognize my day to day work from a year ago. AI is here, like it or not — I choose to like it, and I am having more fun!
			</p>

			<h2>🏋️ Exercise</h2>
			<p>
				I am doing working towards having a (much) more active lifestyle. I start my mornings with <a href="https://thehappybody.com/">The Happy Body</a> exercises and spend about an hour a day either walking, riding a bike, playing outside. It helps a lot.
			</p>

			<h2>☕ Caffeine</h2>
			<p>
				My primary form of caffeine is from my beloved <a href="https://en.wikipedia.org/wiki/Moka_pot">Moka Pot</a>. If I am in a hurry I will get a quick cup from my Nespresso machine.</p>
				<ul>
				<li>
					If you are in Krakow may I suggest you try <a href="https://kellerancoffee.pl/">Kelleran</a> for your beans - Columbia is my favorite.
				</li>
				<li>If you are in the Detroit area, give <a href="https://www.groundcontrolroasters.com/">Ground Control Roaster</a> a shot.
					</li>
			</ul>
			</div>

			<h2>🛠️ What I'm Building</h2>
			<div class="spotlight-row">
				<ProjectSpotlight slug="99-days-of" />
				<ProjectSpotlight slug="any-one-will-do" />
			</div>

			<h2>📖 Currently Reading</h2>
			<ul class="item-list">
				{readingBooks.map(book => (
					<li>
						<div class="item-row">
							<img src={book.image} class="item-thumb book" alt={`${book.title} cover`} />
							<div class="item-content">
								<div class="item-header">
									<a href={book.url} class="item-title">{book.title}</a>
								</div>
								<div class="progress-bar">
									<span class="progress-filled">{progressBar(book.progress!).filled}</span><span class="progress-empty">{progressBar(book.progress!).empty}</span>
									<span class="progress-pct">{book.progress}%</span>
								</div>
								{book.note && <p class="item-note">{book.note}</p>}
							</div>
						</div>
					</li>
				))}
			</ul>

			<h2>📚 Just Finished</h2>
			<ul class="item-list">
				{finishedBooks.map(book => (
					<li>
						<div class="item-row">
							<img src={book.image} class="item-thumb book" alt={`${book.title} cover`} />
							<div class="item-content">
								<div class="item-header">
									<a href={book.url} class="item-title">{book.title}</a>
								</div>
								<div class="star-display">
									{starSegments(book.rating!).map(s => (
										<span class={`star ${s}`}>{s === 'full' ? '★' : '☆'}</span>
									))}
								</div>
								{book.note && <p class="item-note">{book.note}</p>}
							</div>
						</div>
					</li>
				))}
			</ul>

			<h2>🎶 Heavy Rotation</h2>
			<ul class="item-list">
				{albums.map(album => (
					<li>
						<div class="item-row">
							<img src={album.image} class="item-thumb music" alt={`${album.title} album art`} />
							<div class="item-content">
								<div class="item-header">
									<a href={album.url} class="item-title">{album.title}</a>
								</div>
								<p class="item-note">{album.artist}</p>
							</div>
						</div>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
