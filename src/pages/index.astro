---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import IndexHeroImage from "../assets/pages/hero-index.png";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import { FEATURED_POSTS, SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const featuredPosts = (
	await Promise.all(FEATURED_POSTS.map((id) => getEntry("writing", id)))
).filter((post) => post !== undefined);
const [leadPost, ...restPosts] = featuredPosts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Michael Kumm",
			"alternateName": "mkumm",
			"url": "https://mkumm.com",
			"jobTitle": "Senior Software Engineer",
			"sameAs": [
				"https://linkedin.com/in/mkumm",
				"https://github.com/mkumm"
			]
		})}></script>
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "Michael Kumm",
			"url": "https://mkumm.com",
			"description": SITE_DESCRIPTION,
			"author": {
				"@type": "Person",
				"name": "Michael Kumm"
			}
		})}></script>
		<style>
			main {
				width: 1020px;
				max-width: calc(100% - 2em);
				margin: auto;
			}
			@media (max-width: 720px) {
				main {
					width: 100%;
					max-width: 100%;
				}
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				width: 100%;
				max-height: 440px;
				object-fit: cover;
				border-radius: 0;
				box-shadow: none;
			}
			@media (max-width: 720px) {
				.hero-image img {
					max-height: 220px;
				}
			}
			.intro {
				display: flex;
				align-items: flex-start;
				gap: 2rem;
				margin-bottom: 2rem;
			}
			.intro-photo {
				width: 100px;
				height: 100px;
				flex-shrink: 0;
				border-radius: 12px;
				object-fit: cover;
				object-position: center top;
				margin: 0 !important;
				width: 100px !important;
				max-width: 100px !important;
			}
			.intro-text {
				flex: 1;
				min-width: 0;
			}
			.intro-text h1 {
				font-size: 1.4rem;
				margin: 0 0 0.1rem 0;
			}
			.intro-tagline {
				font-size: 0.925rem;
				color: rgb(var(--gray));
				margin: 0;
				font-weight: 500;
				line-height: 1.4;
			}
			@media (max-width: 540px) {
				.intro {
					flex-direction: column;
					align-items: center;
					text-align: center;
					gap: 0.75rem;
				}
				.intro-photo {
					width: 80px !important;
					max-width: 80px !important;
					height: 80px;
				}
				.tech-tags {
					justify-content: center;
				}
			}
			.nav-links {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.75rem;
				margin: 1.75rem 0;
			}
			.nav-link-card {
				display: block;
				padding: 0.875rem 1rem;
				border: none;
				border-radius: 8px;
				background: rgba(var(--accent-rgb), 0.05);
				text-decoration: none;
				color: inherit;
				transition: background 0.15s ease;
			}
			.nav-link-card:hover {
				background: rgba(var(--accent-rgb), 0.1);
			}
			.nav-link-card .card-title {
				display: block;
				font-family: 'Lora', Georgia, serif;
				font-weight: 600;
				font-size: 1rem;
				color: rgb(var(--black));
				margin-bottom: 0.2rem;
			}
			.nav-link-card .card-desc {
				display: block;
				font-size: 0.8rem;
				color: rgb(var(--gray));
				line-height: 1.4;
			}
			@media (max-width: 540px) {
				.nav-links { grid-template-columns: 1fr; }
			}
.tech-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.3rem;
				margin: 0.5rem 0 0;
			}
			.tech-tag {
				font-size: 0.65rem;
				font-weight: 500;
				padding: 0.15rem 0.45rem;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray));
				letter-spacing: 0.03em;
				text-transform: uppercase;
			}
			.contact-callout {
				margin: 1.75rem 0;
				padding: 1rem 1.25rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				border-left: 3px solid var(--accent);
				font-size: 0.9rem;
				color: rgb(var(--gray-dark));
			}
			.contact-callout a {
				color: var(--accent);
				font-weight: 500;
			}
			.contact-callout a:hover {
				text-decoration: underline;
			}
			.page-footer-note {
				margin-top: 3rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.875rem;
				color: rgb(var(--gray));
				text-align: center;
			}
			.page-footer-note a {
				color: rgb(var(--gray));
			}
			.page-footer-note a:hover {
				color: var(--accent);
			}
			.featured {
				display: grid;
				grid-template-columns: 1.3fr 1fr;
				gap: 1.75rem;
				margin: 2rem 0;
			}
			.featured-secondary {
				display: flex;
				flex-direction: column;
				gap: 1.75rem;
			}
			.featured-card {
				display: flex;
				flex-direction: column;
				height: 100%;
				text-decoration: none;
				color: inherit;
			}
			.featured-card img {
				display: block;
				width: 100% !important;
				max-width: 100% !important;
				margin: 0 !important;
				object-fit: cover;
				border-radius: 0;
				transition: opacity 0.2s ease;
			}
			.featured-card:hover img {
				opacity: 0.9;
			}
			.featured-lead img {
				height: 320px;
			}
			.featured-secondary .featured-card img {
				height: 140px;
			}
			.featured-card .card-body {
				display: flex;
				flex-direction: column;
				flex: 1;
				gap: 0.35rem;
				margin-top: 0.75rem;
				padding-top: 0.6rem;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.featured-secondary .card-body {
				margin-top: 0.6rem;
				padding-top: 0.5rem;
			}
			.featured-card .card-date {
				font-size: 0.78rem;
				text-transform: uppercase;
				letter-spacing: 0.07em;
				font-weight: 500;
				color: rgb(var(--gray));
				margin: 0;
			}
			.featured-card .card-title {
				font-family: 'Lora', Georgia, serif;
				font-weight: 600;
				color: rgb(var(--black));
				line-height: 1.35;
				margin: 0;
				transition: color 0.15s ease;
			}
			.featured-lead .card-title {
				font-size: 1.5rem;
			}
			.featured-secondary .card-title {
				font-size: 1.05rem;
			}
			.featured-card:hover .card-title {
				color: var(--accent);
			}
			.featured-card .card-description {
				font-size: 0.9rem;
				color: rgb(var(--gray));
				line-height: 1.5;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.featured-secondary .card-description {
				font-size: 0.825rem;
				-webkit-line-clamp: 2;
			}
			.featured-card .card-arrow {
				font-size: 0.78rem;
				color: rgb(var(--gray));
				margin-top: 0.1rem;
			}
			@media (max-width: 720px) {
				.featured {
					grid-template-columns: 1fr;
				}
				.featured-lead img {
					height: 220px;
				}
			}
			.more-writing {
				text-align: center;
				margin: 1.5rem 0 0;
				font-size: 0.9rem;
			}
			.more-writing a {
				color: var(--accent);
				font-weight: 500;
			}
			.more-writing a:hover {
				text-decoration: underline;
			}
		</style>
	</head>

	<body>
		<Header />
		<div class="hero-image">
			{IndexHeroImage && (
				<Image src={IndexHeroImage} alt="hero image" loading="eager" />
			)}
		</div>
		<main>
				<h2>
				Software, side projects, and the ongoing work of getting better.
				</h2>
				<p>A few selected posts</p>

			{leadPost && (
				<div class="featured">
					<a class="featured-card featured-lead" href={`/writing/${leadPost.id}/`}>
						{leadPost.data.heroImage && (
							<Image
								width={720}
								height={480}
								src={leadPost.data.heroImage}
								alt={"image: " + leadPost.data.title}
								loading="eager"
							/>
						)}
						<div class="card-body">
							<p class="card-date">
								<FormattedDate date={leadPost.data.pubDate} />
							</p>
							<h2 class="card-title">{leadPost.data.title}</h2>
							{leadPost.data.description && (
								<p class="card-description">{leadPost.data.description}</p>
							)}
							<span class="card-arrow">Read post &rarr;</span>
						</div>
					</a>
					<div class="featured-secondary">
						{restPosts.map((post) => (
							<a class="featured-card" href={`/writing/${post.id}/`}>
								{post.data.heroImage && (
									<Image
										width={480}
										height={280}
										src={post.data.heroImage}
										alt={"image: " + post.data.title}
										loading="eager"
									/>
								)}
								<div class="card-body">
									<p class="card-date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<h3 class="card-title">{post.data.title}</h3>
									{post.data.description && (
										<p class="card-description">{post.data.description}</p>
									)}
									<span class="card-arrow">Read post &rarr;</span>
								</div>
							</a>
						))}
					</div>
				</div>
			)}

			<p class="more-writing"><a href="/writing/">See more in the Writing section &rarr;</a></p>

<p class="page-footer-note">
				All photos on this site are my own, available under a Creative Commons license.
				DM me on <a href="https://www.instagram.com/mkumm/">Instagram</a> for full-resolution versions.
			</p>
		</main>
	</body>
	<Footer />
</html>
