---
import { Image } from 'astro:assets';
import WritingHeroImage from '../../assets/pages/hero-writing.png';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostSpotlight from '../../components/PostSpotlight.astro';
import { WRITING_PAGE_SIZE, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = (await getCollection('writing')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return paginate(posts, { pageSize: WRITING_PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const isFirstPage = page.currentPage === 1;
const pageTitle = isFirstPage
	? `Writing — ${SITE_TITLE}`
	: `Writing (Page ${page.currentPage} of ${page.lastPage}) — ${SITE_TITLE}`;
const offset = (page.currentPage - 1) * page.size;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description="Writing on software, systems, Elixir, and things I find interesting." />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "ItemList",
			"name": "Writing — Michael Kumm",
			"url": `https://mkumm.com${page.url.current}`,
			"itemListElement": page.data.map((post, i) => ({
				"@type": "ListItem",
				"position": offset + i + 1,
				"url": `https://mkumm.com/writing/${post.id}/`,
				"name": post.data.title,
			}))
		})}></script>
		<style>
			main {
				width: 1020px;
				max-width: calc(100% - 2em);
				margin: auto;
			}
			.hero-image img {
				display: block;
				width: 100%;
				max-height: 360px;
				object-fit: cover;
				border-radius: 0;
			}
			.page-header {
				margin-bottom: 2.5rem;
				padding-bottom: 1.25rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.page-header h1 {
				margin: 0 0 0.25rem 0;
				font-size: 2rem;
			}
			.page-header p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.spotlight-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				column-gap: 2.5rem;
				row-gap: 3.5rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			@keyframes fadeInUp {
				from { opacity: 0; transform: translateY(16px); }
				to   { opacity: 1; transform: translateY(0); }
			}
			.spotlight-grid li {
				animation: fadeInUp 0.35s ease both;
			}
			.spotlight-grid li:nth-child(1)  { animation-delay: 0.04s; }
			.spotlight-grid li:nth-child(2)  { animation-delay: 0.08s; }
			.spotlight-grid li:nth-child(3)  { animation-delay: 0.12s; }
			.spotlight-grid li:nth-child(4)  { animation-delay: 0.16s; }
			.spotlight-grid li:nth-child(5)  { animation-delay: 0.20s; }
			.spotlight-grid li:nth-child(6)  { animation-delay: 0.24s; }
			.spotlight-grid li:nth-child(7)  { animation-delay: 0.28s; }
			.spotlight-grid li:nth-child(8)  { animation-delay: 0.32s; }
			.spotlight-grid li:nth-child(9)  { animation-delay: 0.36s; }
			.spotlight-grid li:nth-child(10) { animation-delay: 0.40s; }
			.pagination {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-top: 2.5rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.pagination-link {
				font-size: 0.85rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.07em;
				color: var(--accent);
				text-decoration: none;
			}
			.pagination-link:hover {
				text-decoration: underline;
			}
			.pagination-spacer {
				visibility: hidden;
			}
			.pagination-status {
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				main { width: 100%; max-width: 100%; }
				.spotlight-grid {
					grid-template-columns: 1fr;
					row-gap: 2.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="hero-image">
			{WritingHeroImage && (
				<Image layout="constrained" src={WritingHeroImage} alt="Writing hero" loading="eager" />
			)}
		</div>
		<main>
			<div class="page-header">
				<h1>Writing</h1>
				<p>Writing on software, systems, and things I find interesting.</p>
			</div>
			<ul class="spotlight-grid">
				{page.data.map((post) => (
					<li>
						<PostSpotlight slug={post.id} />
					</li>
				))}
			</ul>
			{page.lastPage > 1 && (
				<nav class="pagination">
					{page.url.prev ? (
						<a href={page.url.prev} class="pagination-link">← Newer</a>
					) : <span class="pagination-spacer pagination-link">← Newer</span>}
					<span class="pagination-status">Page {page.currentPage} of {page.lastPage}</span>
					{page.url.next ? (
						<a href={page.url.next} class="pagination-link">Older →</a>
					) : <span class="pagination-spacer pagination-link">Older →</span>}
				</nav>
			)}
		</main>
		<Footer />
	</body>
</html>
