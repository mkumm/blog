---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import WritingPost from '../../layouts/WritingPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('writing');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'writing'>;

const post = Astro.props;
const { Content } = await render(post);
const readingTime = Math.max(1, Math.ceil((post.body?.trim().split(/\s+/).length ?? 0) / 200));
---

<WritingPost {...post.data} readingTime={readingTime}>
	<Content />
</WritingPost>
