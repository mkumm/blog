---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import TagList from '../../../components/TagList.astro';
import { SITE_TITLE } from '../../../consts';
import { tagToSlug } from '../../../utils/tags';

export const getStaticPaths = (async () => {
	const posts = await getCollection('writing');
	const tagMap = new Map<string, { label: string; posts: typeof posts }>();

	for (const post of posts) {
		for (const tag of post.data.tags ?? []) {
			const slug = tagToSlug(tag);
			const entry = tagMap.get(slug);
			if (entry) {
				entry.posts.push(post);
			} else {
				tagMap.set(slug, { label: tag, posts: [post] });
			}
		}
	}

	return Array.from(tagMap.entries()).map(([slug, { label, posts: tagPosts }]) => ({
		params: { tag: slug },
		props: {
			label,
			posts: tagPosts
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
				.map((post) => ({
					...post,
					readingTime: Math.max(1, Math.ceil((post.body?.trim().split(/\s+/).length ?? 0) / 200)),
				})),
		},
	}));
}) satisfies GetStaticPaths;

const { label, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tag: ${label} — ${SITE_TITLE}`} description={`Posts tagged "${label}".`} />
		<style>
			main {
				width: 1020px;
				max-width: calc(100% - 2em);
				margin: auto;
			}
			.page-header {
				margin-bottom: 2.5rem;
				padding-bottom: 1.25rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.page-header h1 {
				margin: 0 0 0.25rem 0;
				font-size: 2rem;
			}
			.page-header p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.page-header .back-link {
				display: inline-block;
				margin-top: 0.75rem;
				font-size: 0.85rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.07em;
				color: var(--accent);
				text-decoration: none;
			}
			.page-header .back-link:hover {
				text-decoration: underline;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 2rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			ul li a {
				display: flex;
				flex-direction: column;
				height: 100%;
				text-decoration: none;
				color: inherit;
				border-radius: 10px;
				overflow: hidden;
				background: var(--bg-secondary);
				border: 1px solid rgba(var(--gray-light), 0.8);
				transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
			}
			ul li a:hover {
				box-shadow: var(--box-shadow);
				transform: translateY(-3px);
				border-color: rgba(var(--accent-rgb), 0.3);
				text-decoration: none;
			}
			ul li img {
				display: block;
				width: 100% !important;
				height: 220px;
				max-width: 100% !important;
				margin: 0 !important;
				object-fit: cover;
				border-radius: 0;
			}
			.card-body {
				display: flex;
				flex-direction: column;
				flex: 1;
				padding: 1.25rem 1.25rem 1.1rem;
			}
			.card-meta {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				margin-bottom: 0.4rem;
			}
			.card-date {
				font-size: 0.78rem;
				text-transform: uppercase;
				letter-spacing: 0.07em;
				font-weight: 500;
				color: rgb(var(--gray));
			}
			.card-title {
				font-family: 'Lora', Georgia, serif;
				font-size: 1.15rem;
				font-weight: 600;
				color: rgb(var(--black));
				line-height: 1.35;
				margin: 0;
				transition: color 0.15s ease;
			}
			ul li a:hover .card-title {
				color: var(--accent);
			}
			.card-description {
				font-size: 0.875rem;
				color: rgb(var(--gray));
				line-height: 1.5;
				margin: 0.5rem 0 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.card-read-time {
				font-size: 0.75rem;
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			.card-body :global(.tag-list) {
				margin-top: 0.75rem;
			}
			@media (max-width: 720px) {
				main { width: 100%; max-width: 100%; }
				ul {
					grid-template-columns: 1fr;
					gap: 1.25rem;
				}
				ul li img { height: 200px; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Tag: {label}</h1>
				<p>{posts.length} post{posts.length === 1 ? '' : 's'} tagged &ldquo;{label}&rdquo;.</p>
				<a class="back-link" href="/writing/">← All posts</a>
			</div>
			<ul>
				{posts.map((post) => (
					<li>
						<a href={`/writing/${post.id}/`}>
							{post.data.heroImage && (
								<Image
									width={720}
									height={360}
									src={post.data.heroImage}
									alt={"image: " + post.data.title}
									loading="eager"
								/>
							)}
							<div class="card-body">
								<div class="card-meta">
									<span class="card-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<span class="card-read-time">{post.readingTime} min read</span>
								</div>
								<h4 class="card-title">{post.data.title}</h4>
								{post.data.description && (
									<p class="card-description">{post.data.description}</p>
								)}
								<TagList tags={post.data.tags} asLinks={false} />
							</div>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
